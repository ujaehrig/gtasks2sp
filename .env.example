# Access token from Super Productivity: Settings -> Misc -> Access Token
SP_TOKEN=
# Base URL of the local REST API
SP_API=http://127.0.0.1:3876
# Existing Super Productivity tag every imported task receives
SP_IMPORT_TAG=gtask
# Path of the import register (SQLite)
TASKS2SP_DB=~/.local/share/tasks2sp/import.sqlite
